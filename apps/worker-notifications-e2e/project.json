{
  "name": "worker-notifications-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["worker-notifications"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "dependsOn": ["worker-notifications:build", "worker-notifications:serve"],
      "options": {
        "jestConfig": "apps/worker-notifications-e2e/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
