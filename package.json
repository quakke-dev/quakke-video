{
  "name": "quakke-video",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=10.22.0 <11"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "PORT=3333 nx run-many -t dev,serve -p web,studio,admin,api,worker-media,worker-notifications --parallel=6 --outputStyle=stream",
    "dev:web": "nx dev web",
    "dev:studio": "nx dev studio",
    "dev:admin": "nx dev admin",
    "dev:api": "PORT=3333 nx serve api",
    "dev:worker-media": "nx serve worker-media",
    "dev:worker-notifications": "nx serve worker-notifications",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "affected:lint": "nx affected -t lint",
    "affected:typecheck": "nx affected -t typecheck",
    "affected:test": "nx affected -t test",
    "affected:build": "nx affected -t build",
    "affected:check": "nx affected -t lint,typecheck,test,build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "cm": "cz",
    "graph": "nx graph",
    "infra:up": "docker compose --env-file .env.local up -d --wait",
    "infra:down": "docker compose --env-file .env.local down",
    "infra:logs": "docker compose --env-file .env.local logs -f"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/devkit": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/jest": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/nest": "23.0.1",
    "@nx/next": "23.0.1",
    "@nx/node": "23.0.1",
    "@nx/playwright": "23.0.1",
    "@nx/react": "23.0.1",
    "@nx/rollup": "23.0.1",
    "@nx/storybook": "23.0.1",
    "@nx/vite": "23.0.1",
    "@nx/vitest": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/webpack": "23.0.1",
    "@playwright/test": "^1.37.0",
    "@rollup/plugin-url": "^8.0.2",
    "@svgr/rollup": "^8.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "commitizen": "^4.3.2",
    "core-js": "^3.36.1",
    "cz-git": "^1.13.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jiti": "2.7.0",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.0.8",
    "nx": "23.0.1",
    "prettier": "^3.8.4",
    "rollup": "^4.14.0",
    "sass": "1.97.2",
    "storybook": "^10.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "verdaccio": "^6.3.2",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "axios": "^1.6.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
