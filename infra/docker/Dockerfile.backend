# syntax=docker/dockerfile:1.7

FROM node:24.18.0-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436 AS builder

ENV HUSKY=0 \
    NX_DAEMON=false

WORKDIR /workspace

RUN npm install --global pnpm@10.22.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch --frozen-lockfile

COPY . .
RUN pnpm install --offline --frozen-lockfile

ARG PROJECT
RUN pnpm nx build "${PROJECT}" --configuration=production

FROM node:24.18.0-alpine3.23@sha256:595398b0081eacda8e1c4c5b97b76cd1020e4d58a8ebcb4843b9bca1e79e7436 AS runtime

ENV NODE_ENV=production

WORKDIR /app

# Runtime images never install packages; remove bundled package managers and their dependencies.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    && rm -f \
        /usr/local/bin/corepack \
        /usr/local/bin/npm \
        /usr/local/bin/npx \
        /usr/local/bin/pnpm \
        /usr/local/bin/pnpx \
        /usr/local/bin/yarn \
        /usr/local/bin/yarnpkg \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs app

FROM runtime AS api
COPY --from=builder --chown=app:nodejs /workspace/apps/api/dist/main.js ./main.js
USER app
EXPOSE 3000
CMD ["node", "main.js"]

FROM runtime AS worker-notifications
COPY --from=builder --chown=app:nodejs /workspace/apps/worker-notifications/dist/main.js ./main.js
USER app
CMD ["node", "main.js"]

FROM runtime AS worker-media
USER root
RUN apk add --no-cache ffmpeg
COPY --from=builder --chown=app:nodejs /workspace/apps/worker-media/dist/main.js ./main.js
USER app
CMD ["node", "main.js"]
