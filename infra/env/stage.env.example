APP_ENV=stage
LOG_LEVEL=debug

IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=quakke

WEB_DOMAIN=quakke-video-stage.tech
STUDIO_DOMAIN=studio.quakke-video-stage.tech
ADMIN_DOMAIN=admin.quakke-video-stage.tech
API_DOMAIN=api.quakke-video-stage.tech
RABBIT_DOMAIN=rabbit.quakke-video-stage.tech
CORS_ORIGINS=https://quakke-video-stage.tech,https://studio.quakke-video-stage.tech,https://admin.quakke-video-stage.tech

POSTGRES_DB=quakke_video_stage
POSTGRES_USER=quakke_stage
POSTGRES_PASSWORD=replace-with-random-stage-password
DATABASE_URL=postgresql://quakke_stage:replace-with-random-stage-password@postgres:5432/quakke_video_stage

REDIS_PASSWORD=replace-with-random-stage-password
REDIS_URL=redis://:replace-with-random-stage-password@redis:6379

RABBITMQ_USER=quakke_stage
RABBITMQ_PASSWORD=replace-with-random-stage-password
RABBITMQ_URL=amqp://quakke_stage:replace-with-random-stage-password@rabbitmq:5672

S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY=replace-with-timeweb-access-key
S3_SECRET_KEY=replace-with-timeweb-secret-key
S3_BUCKET_MEDIA=quakke-video-stage-media
S3_BUCKET_BACKUPS=quakke-video-stage-backups

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-at-least-32-different-random-bytes
SMTP_URL=

# Resource limits are safety rails, not capacity guarantees.
POSTGRES_MEMORY_LIMIT=256m
POSTGRES_CPU_LIMIT=0.5
REDIS_MAXMEMORY=48mb
REDIS_MEMORY_LIMIT=64m
REDIS_CPU_LIMIT=0.25
RABBITMQ_MEMORY_LIMIT=256m
RABBITMQ_CPU_LIMIT=0.35
API_NODE_HEAP_MB=128
API_MEMORY_LIMIT=192m
API_CPU_LIMIT=0.5
WEB_NODE_HEAP_MB=96
WEB_MEMORY_LIMIT=160m
WEB_CPU_LIMIT=0.35
STUDIO_NODE_HEAP_MB=96
STUDIO_MEMORY_LIMIT=160m
STUDIO_CPU_LIMIT=0.35
ADMIN_NODE_HEAP_MB=96
ADMIN_MEMORY_LIMIT=160m
ADMIN_CPU_LIMIT=0.35
MEDIA_CONCURRENCY=1
WORKER_MEDIA_NODE_HEAP_MB=128
WORKER_MEDIA_MEMORY_LIMIT=512m
WORKER_MEDIA_CPU_LIMIT=1
WORKER_MEDIA_TMPFS_SIZE=256m
WORKER_NOTIFICATIONS_NODE_HEAP_MB=96
WORKER_NOTIFICATIONS_MEMORY_LIMIT=160m
WORKER_NOTIFICATIONS_CPU_LIMIT=0.35
