APP_ENV=production
LOG_LEVEL=info

IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=quakke

WEB_DOMAIN=quakke-video.ru
STUDIO_DOMAIN=studio.quakke-video.ru
ADMIN_DOMAIN=admin.quakke-video.ru
API_DOMAIN=api.quakke-video.ru
RABBIT_DOMAIN=rabbit.quakke-video.ru
CORS_ORIGINS=https://quakke-video.ru,https://studio.quakke-video.ru,https://admin.quakke-video.ru

POSTGRES_DB=quakke_video_production
POSTGRES_USER=quakke_production
POSTGRES_PASSWORD=replace-with-random-production-password
DATABASE_URL=postgresql://quakke_production:replace-with-random-production-password@postgres:5432/quakke_video_production

REDIS_PASSWORD=replace-with-random-production-password
REDIS_URL=redis://:replace-with-random-production-password@redis:6379

RABBITMQ_USER=quakke_production
RABBITMQ_PASSWORD=replace-with-random-production-password
RABBITMQ_URL=amqp://quakke_production:replace-with-random-production-password@rabbitmq:5672

S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY=replace-with-timeweb-access-key
S3_SECRET_KEY=replace-with-timeweb-secret-key
S3_BUCKET_MEDIA=quakke-video-production-media
S3_BUCKET_BACKUPS=quakke-video-production-backups

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-at-least-32-different-random-bytes
SMTP_URL=

# Resource limits are safety rails, not capacity guarantees.
POSTGRES_MEMORY_LIMIT=384m
POSTGRES_CPU_LIMIT=0.75
REDIS_MAXMEMORY=96mb
REDIS_MEMORY_LIMIT=128m
REDIS_CPU_LIMIT=0.35
RABBITMQ_MEMORY_LIMIT=384m
RABBITMQ_CPU_LIMIT=0.5
API_NODE_HEAP_MB=256
API_MEMORY_LIMIT=384m
API_CPU_LIMIT=0.75
WEB_NODE_HEAP_MB=192
WEB_MEMORY_LIMIT=256m
WEB_CPU_LIMIT=0.5
STUDIO_NODE_HEAP_MB=192
STUDIO_MEMORY_LIMIT=256m
STUDIO_CPU_LIMIT=0.5
ADMIN_NODE_HEAP_MB=192
ADMIN_MEMORY_LIMIT=256m
ADMIN_CPU_LIMIT=0.5
MEDIA_CONCURRENCY=1
WORKER_MEDIA_NODE_HEAP_MB=256
WORKER_MEDIA_MEMORY_LIMIT=768m
WORKER_MEDIA_CPU_LIMIT=1.5
WORKER_MEDIA_TMPFS_SIZE=512m
WORKER_NOTIFICATIONS_NODE_HEAP_MB=192
WORKER_NOTIFICATIONS_MEMORY_LIMIT=256m
WORKER_NOTIFICATIONS_CPU_LIMIT=0.5
