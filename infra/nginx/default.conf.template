map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

upstream production_api {
  server production-api:3000;
  keepalive 32;
}

upstream production_web {
  server production-web:3000;
  keepalive 16;
}

upstream production_studio {
  server production-studio:3000;
  keepalive 16;
}

upstream production_admin {
  server production-admin:3000;
  keepalive 16;
}

upstream production_rabbitmq {
  server production-rabbitmq:15672;
  keepalive 8;
}

upstream stage_api {
  server stage-api:3000;
  keepalive 16;
}

upstream stage_web {
  server stage-web:3000;
  keepalive 8;
}

upstream stage_studio {
  server stage-studio:3000;
  keepalive 8;
}

upstream stage_admin {
  server stage-admin:3000;
  keepalive 8;
}

upstream stage_rabbitmq {
  server stage-rabbitmq:15672;
  keepalive 4;
}

server {
  listen 80;
  listen [::]:80;
  server_name
    ${PROD_WEB_DOMAIN}
    ${PROD_STUDIO_DOMAIN}
    ${PROD_ADMIN_DOMAIN}
    ${PROD_API_DOMAIN}
    ${PROD_RABBIT_DOMAIN}
    ${STAGE_WEB_DOMAIN}
    ${STAGE_STUDIO_DOMAIN}
    ${STAGE_ADMIN_DOMAIN}
    ${STAGE_API_DOMAIN}
    ${STAGE_RABBIT_DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${PROD_WEB_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${TLS_CERTIFICATE_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${TLS_CERTIFICATE_NAME}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:quakke_tls:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  server_tokens off;
  client_max_body_size 128m;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location /api/ {
    proxy_pass http://production_api;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-ID $request_id;
  }

  location / {
    proxy_pass http://production_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

